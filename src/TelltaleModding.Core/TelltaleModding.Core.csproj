<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TelltaleModding.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/games.json" />
    <!-- Bone names collected by RandomTBush (RTB-3DSMax-Scripts, TelltaleHashDBs). -->
    <EmbeddedResource Include="Data/BoneNames.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLayer" Version="1.16.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TelltaleModding.Core.Tests" />
  </ItemGroup>

  <!-- Linux Oodle loader, if it has been built. Stays a separate file even in a single-file publish. -->
  <ItemGroup Condition="Exists('..\..\engine\oodle\libtelltale_oodle.so')">
    <None Include="..\..\engine\oodle\libtelltale_oodle.so" Link="libtelltale_oodle.so"
          CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
