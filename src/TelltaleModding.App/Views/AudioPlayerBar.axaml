<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TelltaleModding.App.ViewModels"
             x:Class="TelltaleModding.App.Views.AudioPlayerBar"
             x:DataType="vm:AudioPlayerViewModel">

    <!-- Play/pause · stop · timeline · time -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Classes="primary round" Width="38" Height="38" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / pause">
            <Panel>
                <PathIcon Data="{StaticResource IconPlay}" Foreground="White" IsVisible="{Binding !IsPlaying}" />
                <PathIcon Data="{StaticResource IconPause}" Foreground="White" IsVisible="{Binding IsPlaying}" />
            </Panel>
        </Button>
        <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
            <PathIcon Data="{StaticResource IconStop}" />
        </Button>
        <Panel Grid.Column="2" Margin="10,0" VerticalAlignment="Center">
            <Slider Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position}" Margin="0,-10"
                    IsEnabled="{Binding Clip, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>
        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1" MinWidth="84">
            <TextBlock Text="{Binding TimeText}" FontSize="12" HorizontalAlignment="Right"
                       FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Text="{Binding FormatText}" Classes="faint" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
