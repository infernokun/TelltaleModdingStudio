<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TelltaleModding.App.ViewModels"
        xmlns:games="clr-namespace:TelltaleModding.Core.Games;assembly=TelltaleModding.Core"
        xmlns:views="clr-namespace:TelltaleModding.App.Views"
        x:Class="TelltaleModding.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Telltale Modding Studio"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="12">

        <!-- Toolbar: game selection + engine status -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Telltale Modding Studio" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                          Width="320" VerticalAlignment="Center"
                          PlaceholderText="Select a game…">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="games:GameEntry">
                            <TextBlock Text="{Binding Name}" FontSize="12" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding GameKindDisplay}" Foreground="Gray" FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Text="{Binding EngineStatus}" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="420" ToolTip.Tip="{Binding EngineStatus}" />
        </DockPanel>

        <!-- Collapsible output log -->
        <Expander DockPanel.Dock="Bottom" Header="Output" Margin="0,8,0,0"
                  IsExpanded="{Binding IsRunning, Mode=OneWay}">
            <Grid RowDefinitions="Auto,140">
                <StackPanel Grid.Row="0" HorizontalAlignment="Right"
                            Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                    <ProgressBar IsIndeterminate="True" Width="120"
                                 IsVisible="{Binding IsRunning}" />
                    <Button Content="Cancel" Command="{Binding CancelRunCommand}" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" />
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas,Menlo,monospace" FontSize="11" />
            </Grid>
        </Expander>

        <!-- Browse | Preview | Mod project -->
        <Grid ColumnDefinitions="360,6,*,6,300">

            <!-- Browse panel -->
            <TabControl Grid.Column="0" Padding="0,4,0,0">
                <TabItem Header="Archive">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,6,0,0">
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Open…"
                                    Command="{Binding OpenArchiveCommand}" Margin="6,0,0,0"
                                    ToolTip.Tip="Open a .ttarch/.ttarch2 archive" />
                            <TextBox Text="{Binding ArchivePath}" IsReadOnly="True"
                                     Watermark="No archive selected" />
                        </DockPanel>

                        <DockPanel Grid.Row="1" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ArchiveInfoDisplay}"
                                       Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBox Text="{Binding EntryFilter}"
                                     Watermark="Filter (name or category)…" />
                        </DockPanel>

                        <ListBox Grid.Row="2" ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArchiveEntryViewModel">
                                    <Grid ColumnDefinitions="*,80,70">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}"
                                                   Foreground="Gray" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                   Foreground="Gray" FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3" Spacing="6" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="List files" Command="{Binding ListArchiveCommand}" />
                                <Button Content="Extract selected" Command="{Binding ExtractSelectedCommand}" />
                                <Button Content="Extract all" Command="{Binding ExtractAllCommand}" />
                            </StackPanel>
                            <CheckBox Content="Decode textures/audio (-m)" IsChecked="{Binding MetaExtract}"
                                      ToolTip.Tip="Extract DDS from D3DTX, OGG from AUD. Do not use for files you plan to rebuild into a patch." />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Folder">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,6,0,0">
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Open…"
                                    Command="{Binding OpenFolderCommand}" Margin="6,0,0,0"
                                    ToolTip.Tip="Browse a folder you extracted an archive into" />
                            <TextBox Text="{Binding FolderPath}" IsReadOnly="True"
                                     Watermark="No folder open" />
                        </DockPanel>

                        <TextBox Grid.Row="1" Margin="0,0,0,6" Text="{Binding FolderFilter}"
                                 Watermark="Filter files (e.g. rhys, .skl, ColorA)…" />

                        <TreeView Grid.Row="2" ItemsSource="{Binding FolderRoots}"
                                  SelectedItem="{Binding SelectedFolderNode}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" x:DataType="vm:FileNodeViewModel" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:FileNodeViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Icon}" FontSize="12" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <!-- Preview panel: the workspace centerpiece -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="4,0">
                <DockPanel Grid.Row="0">
                    <TextBlock Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Orientation="Horizontal" Spacing="6">
                        <Button Content="Export DDS…" FontSize="11" Padding="8,3"
                                Command="{Binding ExportDdsCommand}"
                                ToolTip.Tip="Convert the selected .d3dtx to a standard DDS file" />
                        <Button Content="Open .dds…" FontSize="11" Padding="8,3"
                                Command="{Binding PreviewFileCommand}" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Margin="0,6">
                    <Panel x:Name="ViewportHost" Background="Transparent">
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Margin="8"
                               IsVisible="{Binding !IsMeshPreview}" />
                        <views:MeshViewport x:Name="Viewport"
                                            IsVisible="{Binding IsMeshPreview}" />
                    </Panel>
                </Border>

                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="{Binding PreviewStatus}" Foreground="Gray" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PreviewStatus}" />
                    <TextBlock Text="{Binding FolderInfo}" Foreground="Gray" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FolderInfo}" />
                    <ItemsControl ItemsSource="{Binding ModelDetails}" MaxHeight="110"
                                  IsVisible="{Binding IsMeshPreview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" Foreground="Gray" FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel IsVisible="{Binding IsMeshPreview}" Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"
                                    VerticalAlignment="Top">
                            <Button Content="Find animations" FontSize="11" Padding="6,2"
                                    Command="{Binding FindAnimationsCommand}"
                                    ToolTip.Tip="Scan the open folder for animations matching this model's skeleton" />
                            <Button Content="▶" FontSize="11" Padding="8,2"
                                    Command="{Binding PlayAnimationCommand}" />
                            <Button Content="■" FontSize="11" Padding="8,2"
                                    Command="{Binding StopAnimationCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBox Text="{Binding AnimationFilter}" Watermark="Filter animations (e.g. shrug, idle sasha)…"
                                     FontSize="11" Padding="6,3" />
                            <ListBox ItemsSource="{Binding FilteredAnimations}" SelectedItem="{Binding SelectedAnimation}"
                                     MaxHeight="120" FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MainWindowViewModel+AnimationItem">
                                        <TextBlock Text="{Binding Display}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />

            <!-- Mod project panel -->
            <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Mod project" FontWeight="SemiBold" Margin="0,0,0,6" />

                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0">
                        <Button Content="Open" Command="{Binding LoadProjectCommand}" />
                        <Button Content="Save" Command="{Binding SaveProjectCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding ProjectName}" Watermark="Mod name" />
                </DockPanel>

                <ListBox Grid.Row="2" ItemsSource="{Binding Swaps}"
                         SelectedItem="{Binding SelectedSwap}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SwapViewModel">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <CheckBox Grid.Column="0" Grid.RowSpan="2"
                                          IsChecked="{Binding Enabled}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="{Binding TargetAssetName}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Text="{Binding ReplacementFileName}"
                                           Foreground="Gray" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,6,0,6">
                    <Button Content="Add swap from selection"
                            Command="{Binding AddSwapFromEntryCommand}"
                            ToolTip.Tip="Pick a replacement for the file selected in the archive browser" />
                    <Button Content="Remove" Command="{Binding RemoveSwapCommand}" />
                </StackPanel>

                <Button Grid.Row="4" Content="Build patch archive"
                        Command="{Binding BuildPatchCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontWeight="SemiBold"
                        ToolTip.Tip="Builds a minimal 0.ttarch/0.ttarch2 containing only your swapped files" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
