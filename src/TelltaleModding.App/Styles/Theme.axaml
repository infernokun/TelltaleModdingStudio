<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens. Dark-only: the app is centred on a 3D viewport. -->
    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="BgColor">#0E1014</Color>
            <Color x:Key="SurfaceColor">#15181E</Color>
            <Color x:Key="CardColor">#1B1F27</Color>
            <Color x:Key="CardHoverColor">#222733</Color>
            <Color x:Key="BorderColor">#272C37</Color>
            <Color x:Key="TextColor">#E7E9EE</Color>
            <Color x:Key="MutedColor">#9099A8</Color>
            <Color x:Key="FaintColor">#5E6676</Color>
            <Color x:Key="AccentColor">#F0545C</Color>
            <Color x:Key="AccentSoftColor">#33F0545C</Color>
            <Color x:Key="SuccessColor">#4CC38A</Color>
            <Color x:Key="WarnColor">#E9A23B</Color>

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardHover" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="Line" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
            <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />

            <!-- Fluent theme hooks so stock controls pick up the palette. -->
            <Color x:Key="SystemAccentColor">#F0545C</Color>
            <Color x:Key="SystemAccentColorDark1">#D9434B</Color>
            <Color x:Key="SystemAccentColorLight1">#F4767D</Color>
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource CardHoverColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />

            <!-- Icons (Material Design paths, 24×24). -->
            <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
            <StreamGeometry x:Key="IconPerson">M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z</StreamGeometry>
            <StreamGeometry x:Key="IconGrid">M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z</StreamGeometry>
            <StreamGeometry x:Key="IconBuild">M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderAdd">M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z</StreamGeometry>
            <StreamGeometry x:Key="IconRecenter">M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm-7 7H3v4c0 1.1.9 2 2 2h4v-2H5v-4zM5 5h4V3H5c-1.1 0-2 .9-2 2v4h2V5zm14-2h-4v2h4v4h2V5c0-1.1-.9-2-2-2zm0 16h-4v2h4c1.1 0 2-.9 2-2v-4h-2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconExport">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
            <StreamGeometry x:Key="IconLoop">M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
            <StreamGeometry x:Key="IconFace">M9 11.75a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zm6 0a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37C11.07 8.33 14.05 10 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z</StreamGeometry>
            <StreamGeometry x:Key="IconLandscape">M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z</StreamGeometry>
            <StreamGeometry x:Key="IconChat">M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z</StreamGeometry>
            <StreamGeometry x:Key="IconCode">M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z</StreamGeometry>
            <StreamGeometry x:Key="IconNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</StreamGeometry>
            <StreamGeometry x:Key="IconPrevious">M6 6h2v12H6zm3.5 6l8.5 6V6z</StreamGeometry>
            <StreamGeometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</StreamGeometry>
            <StreamGeometry x:Key="IconMute">M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51A8.796 8.796 0 0 0 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06a8.99 8.99 0 0 0 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z</StreamGeometry>
            <StreamGeometry x:Key="IconSkeleton">M12 2a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zm-1 6h2v5h4l2 2-1.4 1.4L16 15h-3v2.6l2.7 3.1-1.5 1.3L12 19.4 9.8 22l-1.5-1.3 2.7-3.1V15H8l-1.6 1.4L5 15l2-2h4V8z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
            <StreamGeometry x:Key="IconSwap">M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- Text roles -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{StaticResource Faint}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.round">
        <Setter Property="CornerRadius" Value="999" />
    </Style>

    <!-- Minimize, maximize and close, drawn in the header (the window has no system title bar) -->
    <Style Selector="Button.caption">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardHover}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Navigation tabs in the header -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg" CornerRadius="8" Padding="12,7" Background="Transparent">
                    <!-- Text-only tabs (no icon in Tag) keep their label centred in the highlight. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <PathIcon Data="{TemplateBinding Tag}" Width="15" Height="15"
                                  Foreground="{TemplateBinding Foreground}"
                                  IsVisible="{TemplateBinding Tag, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
        <Setter Property="Background" Value="{StaticResource Card}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#bg">
        <Setter Property="Background" Value="{StaticResource CardHover}" />
    </Style>

    <!-- The gap between two panels, doubling as a drag handle to resize them. -->
    <Style Selector="GridSplitter.gap">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Border Name="grip" Width="2" Height="36" CornerRadius="1" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.gap:pointerover /template/ Border#grip">
        <Setter Property="Background" Value="{StaticResource Faint}" />
    </Style>

    <!-- Lists: quiet rows with a soft accent selection. -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Card}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14"
                          Foreground="{StaticResource Faint}" Margin="10,0,0,0" />
            </Template>
        </Setter>
    </Style>

    <Style Selector="TabControl.inspector">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.inspector TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="3" />
        <Setter Property="Height" Value="3" />
    </Style>
</Styles>
